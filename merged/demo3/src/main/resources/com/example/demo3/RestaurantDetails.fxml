<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo3.RestaurantDetailsController">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25" />
    </padding>
    <!-- Top bar -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button fx:id="btnIndietro" text="← Indietro" onAction="#onIndietroClick" styleClass="button-secondary" />
        <Label fx:id="nameLabel" styleClass="card-header" />
    </HBox>
    <!-- Detail card -->
    <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
        <GridPane hgap="20" vgap="8">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="130" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <!-- Row 0 -->
            <Label text="Descrizione" styleClass="label-field" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <Label fx:id="descriptionLabel" wrapText="true" GridPane.rowIndex="0" GridPane.columnIndex="1" />
            <!-- Row 1 -->
            <Label text="Sito web" styleClass="label-field" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <Label fx:id="websiteLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" />
            <!-- Row 2 -->
            <Label text="Telefono" styleClass="label-field" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <Label fx:id="phoneLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" />
            <!-- Row 3 -->
            <Label text="Posizione" styleClass="label-field" GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <Label fx:id="locationLabel" wrapText="true" GridPane.rowIndex="3" GridPane.columnIndex="1" />
            <!-- Row 4 -->
            <Label text="Fascia prezzo" styleClass="label-field" GridPane.rowIndex="4" GridPane.columnIndex="0" />
            <Label fx:id="priceRangeLabel" GridPane.rowIndex="4" GridPane.columnIndex="1" />
            <!-- Row 5 -->
            <Label text="Consegna" styleClass="label-field" GridPane.rowIndex="5" GridPane.columnIndex="0" />
            <Label fx:id="deliveryLabel" GridPane.rowIndex="5" GridPane.columnIndex="1" />
            <!-- Row 6 -->
            <Label text="Prenotazione online" styleClass="label-field" GridPane.rowIndex="6" GridPane.columnIndex="0" />
            <Label fx:id="onlineBookingLabel" GridPane.rowIndex="6" GridPane.columnIndex="1" />
            <!-- Row 7 -->
            <Label text="Premio" styleClass="label-field" GridPane.rowIndex="7" GridPane.columnIndex="0" />
            <Label fx:id="awardLabel" GridPane.rowIndex="7" GridPane.columnIndex="1" />
            <!-- Row 8 -->
            <Label text="Stella Verde" styleClass="label-field" GridPane.rowIndex="8" GridPane.columnIndex="0" />
            <Label fx:id="greenStarLabel" GridPane.rowIndex="8" GridPane.columnIndex="1" />
            <!-- Row 9 -->
            <Label text="Proprietario ID" styleClass="label-field" GridPane.rowIndex="9" GridPane.columnIndex="0" />
            <Label fx:id="ownerIdLabel" GridPane.rowIndex="9" GridPane.columnIndex="1" />
            <!-- Row 10 -->
            <Label text="Cucine" styleClass="label-field" GridPane.rowIndex="10" GridPane.columnIndex="0" />
            <Label fx:id="cuisineTypesLabel" wrapText="true" GridPane.rowIndex="10" GridPane.columnIndex="1" />
            <!-- Row 11 -->
            <Label text="Servizi" styleClass="label-field" GridPane.rowIndex="11" GridPane.columnIndex="0" />
            <Label fx:id="servicesLabel" wrapText="true" GridPane.rowIndex="11" GridPane.columnIndex="1" />
            <!-- Row 12 -->
            <Label text="Recensioni" styleClass="label-field" GridPane.rowIndex="12" GridPane.columnIndex="0" />
            <Label fx:id="reviewsCountLabel" wrapText="true" GridPane.rowIndex="12" GridPane.columnIndex="1" />
            <!-- Row 13 -->
            <Label text="ID" styleClass="label-field" GridPane.rowIndex="13" GridPane.columnIndex="0" />
            <Label fx:id="idLabel" GridPane.rowIndex="13" GridPane.columnIndex="1" />
        </GridPane>
    </VBox>
</VBox>