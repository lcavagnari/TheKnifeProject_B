<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="25" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo3.LoginController">
    <padding>
        <Insets top="50" right="50" bottom="50" left="50" />
    </padding>
    <Label text="🔐 Accedi" styleClass="card-header" />
    <VBox styleClass="card" spacing="15" maxWidth="360">
        <TextField fx:id="usernameField" promptText="Username" />
        <PasswordField fx:id="passwordField" promptText="Password" />
        <Label fx:id="errorLabel" wrapText="true" />
        <HBox spacing="15" alignment="CENTER">
            <Button fx:id="btnLogin" text="Login" onAction="#onLoginClick" />
            <Button fx:id="btnAnnulla" text="Annulla" onAction="#onAnnullaClick" styleClass="button-secondary" />
        </HBox>
    </VBox>
</VBox>