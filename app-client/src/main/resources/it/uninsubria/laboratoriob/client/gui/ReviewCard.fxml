<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="4" style="-fx-background-color: #F5F5F5; -fx-background-radius: 8; -fx-padding: 8;"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.uninsubria.laboratoriob.client.gui.controller.ReviewCardController">
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label fx:id="ratingLabel" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #424242;" text="5" />
        <Label fx:id="starsLabel" style="-fx-text-fill: #F4B400; -fx-font-size: 14px;" text="★★★★★" />
        <Label fx:id="timeLabel" style="-fx-text-fill: #757575; -fx-font-size: 11px;" text="01/01/2025 12:00" />
    </HBox>
    <Label fx:id="commentLabel" wrapText="true" style="-fx-text-fill: #424242; -fx-font-size: 15px;" text="Review text..." />

    <!-- Risposta esistente del ristorante (nascosta se non presente) -->
    <VBox fx:id="replyDisplay" spacing="2" managed="false" visible="false"
          style="-fx-padding: 4 0 0 10; -fx-border-color: transparent transparent transparent #007161; -fx-border-width: 0 0 0 2;">
        <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #007161;" text="Risposta del ristorante" />
        <Label fx:id="replyTextLabel" wrapText="true" style="-fx-text-fill: #424242; -fx-font-size: 13px;" />
    </VBox>

    <!-- Riga per i bottoni -->
    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 6 0 0 0;">
        <Button fx:id="replyDeleteCancelButton" styleClass="button-secondary" text="Annulla" onAction="#onReplyDeleteCancel" managed="false" visible="false" />
        <Button fx:id="replyButton" styleClass="button-secondary" text="Reply" onAction="#onReplyAction" managed="false" visible="false" />
        <Button fx:id="deleteButton" styleClass="button-danger" text="Delete" onAction="#onDeleteAction" managed="false" visible="false" />
    </HBox>

    <!-- Casella di risposta, nascosta finché non si preme Reply -->
    <VBox fx:id="replyInputBox" spacing="6" managed="false" visible="false" style="-fx-padding: 6 0 0 0;">
        <TextArea fx:id="replyField" promptText="Scrivi una risposta..." prefRowCount="2" wrapText="true" />
        <HBox alignment="CENTER_RIGHT" spacing="8">
            <Button onAction="#onReplyCancel" styleClass="button-link" text="Annulla" />
            <Button onAction="#onReplySubmit" styleClass="button-secondary" text="Invia" />
        </HBox>
    </VBox>
</VBox>