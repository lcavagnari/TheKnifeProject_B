<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="right-box" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.uninsubria.laboratoriob.client.gui.AddEditRestaurantController">
  <VBox spacing="16" styleClass="right-box">
    <padding>
      <Insets bottom="24" left="24" right="24" top="24"/>
    </padding>
    <!-- Top bar -->
    <HBox alignment="CENTER_LEFT" spacing="16">
      <Button fx:id="btnIndietro" onAction="#onIndietroClick" styleClass="button-secondary" text="← Indietro"/>
      <Label fx:id="titleLabel" styleClass="card-header" text="Nuovo Ristorante"/>
    </HBox>
    <!-- Informazioni generali -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 6, 0.0, 0, 3);">
      <padding>
        <Insets bottom="16" left="16" right="16" top="16"/>
      </padding>
      <Label styleClass="section-header" text="INFORMAZIONI GENERALI"/>
      <VBox spacing="2">
        <Label fx:id="nomeError" managed="false" styleClass="field-error" visible="false" wrapText="true"/>
        <TextField fx:id="nomeField" promptText="Nome ristorante *"/>
      </VBox>
      <TextArea fx:id="descrizioneField" prefRowCount="3" promptText="Descrizione" wrapText="true"/>
      <HBox spacing="10">
        <TextField fx:id="sitoWebField" promptText="Sito web" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="telefonoField" promptText="Telefono" HBox.hgrow="ALWAYS"/>
      </HBox>
    </VBox>
    <!-- Posizione -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 6, 0.0, 0, 3);">
      <padding>
        <Insets bottom="16" left="16" right="16" top="16"/>
      </padding>
      <Label styleClass="section-header" text="POSIZIONE"/>
      <TextField fx:id="indirizzoField" promptText="Via e numero civico"/>
      <HBox spacing="10">
        <TextField fx:id="cittaField" promptText="Città" HBox.hgrow="ALWAYS"/>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
          <Label fx:id="nazioneError" managed="false" styleClass="field-error" visible="false" wrapText="true"/>
          <TextField fx:id="nazioneField" promptText="Nazione (es. Italy)" HBox.hgrow="ALWAYS"/>
        </VBox>
      </HBox>
    </VBox>
    <!-- Dettagli -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 6, 0.0, 0, 3);">
      <padding>
        <Insets bottom="16" left="16" right="16" top="16"/>
      </padding>
      <Label styleClass="section-header" text="DETTAGLI"/>
      <HBox spacing="10">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
          <Label fx:id="prezzoError" managed="false" styleClass="field-error" visible="false" wrapText="true"/>
          <ComboBox fx:id="prezzoCombo" maxWidth="Infinity" promptText="Fascia di prezzo *" HBox.hgrow="ALWAYS"/>
        </VBox>
        <ComboBox fx:id="premioCombo" maxWidth="Infinity" promptText="Riconoscimento" HBox.hgrow="ALWAYS"/>
      </HBox>
      <HBox spacing="24">
        <CheckBox fx:id="consegnaCheck" text="Consegna a domicilio"/>
        <CheckBox fx:id="prenotazioneCheck" text="Prenotazione online"/>
        <CheckBox fx:id="stellaVerdeCheck" text="Stella Verde Michelin"/>
      </HBox>
    </VBox>
    <!-- Cucine -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 6, 0.0, 0, 3);">
      <padding>
        <Insets bottom="16" left="16" right="16" top="16"/>
      </padding>
      <Label styleClass="section-header" text="CUCINE"/>
      <TextField fx:id="cucinaFiltroField" promptText="Filtra per nome..."/>
      <ListView fx:id="cucinaListView" prefHeight="160"/>
    </VBox>
    <!-- Servizi -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 6, 0.0, 0, 3);">
      <padding>
        <Insets bottom="16" left="16" right="16" top="16"/>
      </padding>
      <Label styleClass="section-header" text="SERVIZI"/>
      <HBox spacing="10">
        <TextField fx:id="servizioField" promptText="Es. WiFi, Parcheggio..." HBox.hgrow="ALWAYS"/>
        <Button onAction="#onAggiungiServizioClick" text="Aggiungi"/>
      </HBox>
      <FlowPane fx:id="serviziFlow" hgap="8" vgap="8"/>
    </VBox>
    <Label fx:id="errorLabel" styleClass="label-error" wrapText="true"/>
    <HBox alignment="CENTER" spacing="16">
      <Button fx:id="btnSalva" onAction="#onSalvaClick" styleClass="button-secondary" text="Crea Ristorante"/>
      <Button fx:id="btnAnnulla" onAction="#onAnnullaClick" styleClass="button-danger" text="Annulla"/>
    </HBox>
    <Label styleClass="empty-state-sub" text="Nota: in questa versione le modifiche non vengono ancora salvate su disco." wrapText="true"/>
  </VBox>
</ScrollPane>
