<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.uninsubria.laboratoriob.client.gui.controller.LoginController">
    <Label text="Accedi" styleClass="label-title" />
    <Label text="Inserisci le tue credenziali" styleClass="label-info" />
    <TextField fx:id="usernameField" promptText="Username" />
    <PasswordField fx:id="passwordField" promptText="Password" />
    <Label fx:id="errorLabel" wrapText="true" styleClass="label-error" />
    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="btnLogin" text="Login" onAction="#onLoginClick" />
        <Button fx:id="btnAnnulla" text="Annulla" onAction="#onAnnullaClick" styleClass="button-danger" />
    </HBox>
</VBox>
