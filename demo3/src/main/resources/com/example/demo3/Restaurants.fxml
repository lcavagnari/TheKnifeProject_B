<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo3.RestaurantsController">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25" />
    </padding>
    <!-- Top bar -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button fx:id="btnIndietro" text="← Indietro" onAction="#onIndietroClick" styleClass="button-secondary" />
        <Label fx:id="titleLabel" styleClass="card-header" text="Trova Ristoranti" />
    </HBox>
    <!-- Main card -->
    <VBox styleClass="card" spacing="15" VBox.vgrow="ALWAYS">
        <!-- Search bar (managed by controller) -->
        <HBox fx:id="searchBar" alignment="CENTER" spacing="10" visible="false" managed="false">
            <TextField fx:id="searchField" promptText="Cerca nome, città, tipo cucina..." HBox.hgrow="ALWAYS" />
            <Button text="🔍 Cerca" onAction="#onCercaClick" />
        </HBox>
        <!-- Info label -->
        <Label fx:id="infoLabel" styleClass="label-info" />
        <!-- List -->
        <ListView fx:id="restaurantListView" VBox.vgrow="ALWAYS" prefHeight="320" />
    </VBox>
</VBox>