<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo3.RestaurantsController">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25" />
    </padding>
    <!-- Top bar -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button fx:id="btnIndietro" text="← Indietro" onAction="#onIndietroClick" styleClass="button-secondary" />
        <Label fx:id="titleLabel" styleClass="card-header" text="Trova Ristoranti" />
    </HBox>
    <!-- Search card -->
    <HBox fx:id="searchBar" styleClass="search-card" alignment="CENTER" spacing="10">
        <TextField fx:id="searchField" promptText="Cerca per nome, cucina o città..." HBox.hgrow="ALWAYS" />
        <Button text="Cerca" onAction="#onCercaClick" />
    </HBox>
    <!-- Stats -->
    <HBox fx:id="statsBar" styleClass="stats-bar" alignment="CENTER_LEFT">
        <Label fx:id="infoLabel" styleClass="stats-label" />
    </HBox>
    <!-- Empty state (hidden by default) -->
    <VBox fx:id="emptyState" styleClass="empty-state" visible="false" managed="false">
        <Label styleClass="empty-state-icon" text="🍽" />
        <Label styleClass="empty-state-title" text="Nessun ristorante trovato" />
        <Label styleClass="empty-state-sub" text="Prova a cercare con parole chiave diverse" />
    </VBox>
    <!-- List -->
    <ListView fx:id="restaurantListView" VBox.vgrow="ALWAYS" prefHeight="320" />
</VBox>
