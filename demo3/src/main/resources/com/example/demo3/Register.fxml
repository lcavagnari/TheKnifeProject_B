<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="CENTER" spacing="12" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo3.RegisterController">

    <Label text="Nuovo account" styleClass="label-title" />
    <Label text="Compila i dati per registrarti" styleClass="label-info" />

    <!-- Role selection – visual cards -->
    <HBox spacing="10" alignment="CENTER" styleClass="role-selector">
        <VBox fx:id="roleClienteCard" styleClass="role-card role-card-selected" alignment="CENTER" spacing="4">
            <Label text="Cliente" styleClass="role-card-title" />
            <Label text="Trova e recensisci" styleClass="role-card-sub" />
        </VBox>
        <VBox fx:id="roleGestoreCard" styleClass="role-card" alignment="CENTER" spacing="4">
            <Label text="Gestore" styleClass="role-card-title" />
            <Label text="Gestisci il ristorante" styleClass="role-card-sub" />
        </VBox>
        <!-- Hidden radios for ToggleGroup binding -->
        <RadioButton fx:id="radioCliente" text="Cliente" selected="true" visible="false" managed="false">
            <toggleGroup><ToggleGroup fx:id="tipoUtenteGroup" /></toggleGroup>
        </RadioButton>
        <RadioButton fx:id="radioGestore" text="Gestore" toggleGroup="$tipoUtenteGroup" visible="false" managed="false" />
    </HBox>

    <!-- Account -->
    <Label text="Account" styleClass="section-header" />
    <TextField fx:id="usernameField" promptText="Username * (4-16 caratteri)" />
    <PasswordField fx:id="passwordField" promptText="Password * (min 4 caratteri)" />
    <PasswordField fx:id="confirmPasswordField" promptText="Conferma password *" />

    <!-- Profilo -->
    <Label text="Profilo" styleClass="section-header" />
    <HBox spacing="10">
        <TextField fx:id="nomeField" promptText="Nome *" HBox.hgrow="ALWAYS" />
        <TextField fx:id="cognomeField" promptText="Cognome *" HBox.hgrow="ALWAYS" />
    </HBox>
    <DatePicker fx:id="dataNascitaPicker" promptText="Data di nascita *" />

    <!-- Indirizzo -->
    <Label text="Indirizzo" styleClass="section-header" />
    <TextField fx:id="indirizzoField" promptText="Via e numero civico" />
    <HBox spacing="10">
        <TextField fx:id="cittaField" promptText="Città" HBox.hgrow="ALWAYS" />
        <TextField fx:id="nazioneField" promptText="Nazione (es. Italy)" HBox.hgrow="ALWAYS" />
    </HBox>

    <Label fx:id="errorLabel" wrapText="true" styleClass="label-error" />

    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="btnRegistrati" text="Registrati" onAction="#onRegistratiClick" />
        <Button fx:id="btnAnnulla" text="Annulla" onAction="#onAnnullaClick" styleClass="button-link" />
    </HBox>
</VBox>
