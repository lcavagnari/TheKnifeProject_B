<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.text.FontWeight?>

<VBox fx:id="root" spacing="10" styleClass="right-box" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo3.RestaurantDetailsController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>

    <!-- Top bar: back button + restaurant name -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button fx:id="btnIndietro" text="← Back" onAction="#onIndietroClick" styleClass="button-secondary" />
        <Label fx:id="nameLabel" styleClass="card-header" />
    </HBox>

    <!-- Ribbons row 1: Michelin stars + green star -->
    <HBox spacing="8" alignment="CENTER_LEFT">
        <padding><Insets left="5" /></padding>
        <Label fx:id="awardLabel" styleClass="badge badge-award" visible="false" managed="false" />
        <Label fx:id="greenStarLabel" styleClass="badge badge-green" visible="false" managed="false" />
    </HBox>

    <!-- Ribbons row 2: delivery + online booking -->
    <HBox spacing="8" alignment="CENTER_LEFT">
        <padding><Insets left="5" /></padding>
        <Label fx:id="deliveryLabel" styleClass="badge badge-delivery" visible="false" managed="false" />
        <Label fx:id="onlineBookingLabel" styleClass="badge badge-booking" visible="false" managed="false" />
    </HBox>

    <!-- Detail card -->
    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0.2, 0, 3);" spacing="0">
        <padding><Insets top="12" right="14" bottom="12" left="14" /></padding>

        <!-- Description -->
        <Label fx:id="descriptionLabel" wrapText="true" style="-fx-font-size: 14px; -fx-text-fill: #424242;" />

        <Separator style="-fx-padding: 6 0;" />

        <!-- Website + Phone -->
        <GridPane hgap="20" vgap="10">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <!-- Website column -->
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="2">
                <HBox alignment="CENTER_LEFT" spacing="4">
                    <ImageView fitWidth="14" fitHeight="14" preserveRatio="true">
                        <image><Image url="@images/ic_globe.png" /></image>
                    </ImageView>
                    <Label text="WEBSITE" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #757575;" />
                </HBox>
                <Label fx:id="websiteLabel" style="-fx-text-fill: #007161; -fx-font-size: 13px;" wrapText="true" />
            </VBox>

            <!-- Phone column -->
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="2">
                <HBox alignment="CENTER_LEFT" spacing="4">
                    <ImageView fitWidth="14" fitHeight="14" preserveRatio="true">
                        <image><Image url="@images/ic_phone.png" /></image>
                    </ImageView>
                    <Label text="PHONE NUMBER" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #757575;" />
                </HBox>
                <Label fx:id="phoneLabel" style="-fx-text-fill: #424242; -fx-font-size: 13px;" />
            </VBox>
        </GridPane>

        <Separator style="-fx-padding: 6 0;" />

        <!-- Location + Price Range -->
        <GridPane hgap="20" vgap="10">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <!-- Location column -->
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="2">
                <HBox alignment="CENTER_LEFT" spacing="4">
                    <ImageView fitWidth="14" fitHeight="14" preserveRatio="true">
                        <image><Image url="@images/ic_geomarker.png" /></image>
                    </ImageView>
                    <Label text="LOCATION" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #757575;" />
                </HBox>
                <Label fx:id="locationLabel" wrapText="true" style="-fx-text-fill: #424242; -fx-font-size: 13px;" />
            </VBox>

            <!-- Price Range column -->
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="2">
                <HBox alignment="CENTER_LEFT" spacing="4">
                    <ImageView fitWidth="14" fitHeight="14" preserveRatio="true">
                        <image><Image url="@images/ic_money.png" /></image>
                    </ImageView>
                    <Label text="PRICE RANGE (per-person)" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #757575;" />
                </HBox>
                <Label fx:id="priceRangeLabel" style="-fx-text-fill: #424242; -fx-font-size: 13px;" />
            </VBox>
        </GridPane>

        <Separator style="-fx-padding: 6 0;" />

        <!-- Cuisine + Services -->
        <GridPane hgap="20" vgap="10">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <!-- Cuisine column -->
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="4">
                    <ImageView fitWidth="14" fitHeight="14" preserveRatio="true">
                        <image><Image url="@images/ic_knifeandfork.png" /></image>
                    </ImageView>
                    <Label text="CUISINE" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #757575;" />
                </HBox>
                <FlowPane fx:id="cuisinesFlow" hgap="5" vgap="5" />
            </VBox>

            <!-- Services column -->
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="4">
                    <ImageView fitWidth="14" fitHeight="14" preserveRatio="true">
                        <image><Image url="@images/ic_info.png" /></image>
                    </ImageView>
                    <Label text="SERVICES" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #757575;" />
                </HBox>
                <FlowPane fx:id="servicesFlow" hgap="5" vgap="5" />
            </VBox>
        </GridPane>

        <Separator style="-fx-padding: 6 0;" />

        <!-- Reviews count -->
        <HBox alignment="CENTER_LEFT" spacing="6">
            <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                <image><Image url="@images/ic_star.png" /></image>
            </ImageView>
            <Label fx:id="reviewsCountLabel" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #d4944a;" />
        </HBox>
    </VBox>
</VBox>
